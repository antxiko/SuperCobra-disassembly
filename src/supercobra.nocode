# Zonas que el trazador NO debe leer como codigo: las dos tablas de palabras
# que van INCRUSTADAS DETRAS de un `call 0x4050`.
#
# 0x4050 no es un despachador normal: coge la direccion de retorno con `pop hl`
# y la usa como base de la tabla, asi que los bytes que siguen al call son
# datos y NO se vuelve a ellos (termina en `jp (hl)`).
#     4050: add a,a / pop hl / call 4021h (HL+=A) / ld e,(hl) / inc hl /
#           ld d,(hl) / ex de,hl / jp (hl)
0x46AD 0x46CB   15 palabras (call en 0x46AA); indice = (0xE000), el estado del juego
0x516F 0x517F    8 palabras (call en 0x516C); indice = (0xE003) and 7
